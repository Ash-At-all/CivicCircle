# Public client configuration from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional abuse prevention for anonymous sign-in.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application configuration
NEXT_PUBLIC_APP_URL=https://civiccircle.in
NEXT_PUBLIC_SITE_NAME=CivicCircle

# Never put a service_role key or other server secret in NEXT_PUBLIC_ variables.
# Keep server-only secrets in .env.local without the NEXT_PUBLIC_ prefix.
